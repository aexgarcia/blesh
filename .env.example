# BLESH — variables de entorno de ejemplo.
# Copiar a .env.local para desarrollo. Nunca subir valores reales al repositorio.
# Ningún secreto debe usar el prefijo NEXT_PUBLIC_.

# Entorno lógico de la aplicación: development | test | preview | production
APP_ENV=development

# URL canónica pública (metadata, sitemap). En local:
APP_URL=http://localhost:3000

# GA4 opcional: sin ID no se carga etiqueta ni se muestra banner. No es una credencial.
# Activación en producción exige cuenta/consentimiento; preview siempre deshabilitado.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Activar solo después de configurar propiedad, deshabilitar medición mejorada y validar privacidad.
ANALYTICS_ENABLED=false
# Solo QA local explícito, con ID de una propiedad de PRUEBAS. Mantener false normalmente.
ANALYTICS_QA=false

# Conexión runtime: rol con permisos mínimos (miembro de blesh_runtime).
# Valores de docker-compose.yml local; en Supabase usar el pooler en modo transacción.
DATABASE_URL=postgres://blesh_app:blesh_app_local@localhost:54329/blesh

# false si se conecta a través de un pooler en modo transacción (Supabase/PgBouncer).
DATABASE_PREPARE=true

# Tamaño máximo del pool por instancia del servidor.
DATABASE_POOL_MAX=5

# Conexión de migraciones: rol propietario del esquema. Solo CI/operador, nunca en runtime.
# Debe ser conexión directa o pooler en modo sesión.
MIGRATION_DATABASE_URL=postgres://blesh_migrator:blesh_migrator_local@localhost:54329/blesh

# Autenticación administrativa (Supabase Auth). Solo servidor: sin prefijo NEXT_PUBLIC_.
# Local: valores de `npx supabase status -o env` tras `npm run auth:up`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (admin API: invitaciones, MFA, sesiones). Nunca exponer al navegador.
SUPABASE_SECRET_KEY=

# Tienda (fase 6): número que recibe las solicitudes por WhatsApp, solo dígitos con código
# de país (p. ej. 51 + 9 dígitos), sin "+". Sin valor, las solicitudes quedan deshabilitadas.
# Fuera de producción se trata SIEMPRE como número de prueba (aviso visible en la tienda).
# PENDIENTE: el número oficial lo define el negocio; no usar un contacto real en local/preview.
WHATSAPP_NUMBER=


# Pruebas de integración contra PostgreSQL real (base aislada blesh_test).
TEST_DATABASE_URL=postgres://blesh_app:blesh_app_local@localhost:54329/blesh_test
TEST_MIGRATION_DATABASE_URL=postgres://blesh_migrator:blesh_migrator_local@localhost:54329/blesh_test

# Límite de tasa de la tienda fuera de Vercel: "true" solo si un proxy de confianza fija X-Forwarded-For.
TRUST_PROXY_HEADERS=
